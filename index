<body>
  <h1>모어인어로우</h1>

  <div id="status-bar">
    <div class="player1">
      Player 1:
      <span id="score1">0</span>점
    </div>

    <div class="player2">
      Player 2:
      <span id="score2">0</span>점
    </div>
  </div>

  <div id="game-info"></div>

  <div id="board-container">
    <div id="drop-controls"></div>
    <div id="grid"></div>
    <div id="pop-controls"></div>
  </div>

  <script>
    // --------------------------------
    // 게임 설정
    // --------------------------------
    const ROWS = 6;
    const COLS = 7;
    const WIN_SCORE = 8;
    const MAX_MARBLES = ROWS * COLS;

    // --------------------------------
    // 게임 상태
    // --------------------------------
    let board = createEmptyBoard();

    let currentPlayer = 1;

    let scores = {
      1: 0,
      2: 0
    };

    /*
     * DROP:
     *   보드가 가득 차기 전, 구슬을 넣는 단계
     *
     * REMOVE:
     *   보드가 한 번 가득 찬 후, 구슬을 빼는 단계
     *
     * 보드가 가득 찬 후에는 절대로 DROP으로 돌아가지 않습니다.
     */
    let phase = "DROP";

    // 현재 보드에 들어 있는 구슬 개수
    let marbleCount = 0;

    /*
     * 보드가 가득 찬 순간 점수를 계산했는지 여부
     *
     * 게임 중간에는 false이며,
     * 보드가 가득 찬 순간 true로 변경됩니다.
     */
    let scoreCalculated = false;

    // --------------------------------
    // DOM 요소
    // --------------------------------
    const gridEl = document.getElementById("grid");
    const dropControlsEl = document.getElementById("drop-controls");
    const popControlsEl = document.getElementById("pop-controls");
    const gameInfoEl = document.getElementById("game-info");
    const score1El = document.getElementById("score1");
    const score2El = document.getElementById("score2");

    // --------------------------------
    // 보드 생성
    // --------------------------------
    function createEmptyBoard() {
      return Array.from(
        { length: ROWS },
        () => Array(COLS).fill(0)
      );
    }

    // --------------------------------
    // 보드 초기화
    // --------------------------------
    function initBoard() {
      gridEl.innerHTML = "";
      dropControlsEl.innerHTML = "";
      popControlsEl.innerHTML = "";

      // 상단 구슬 넣기 버튼
      for (let col = 0; col < COLS; col++) {
        const dropButton = document.createElement("button");

        dropButton.className = "control-btn";
        dropButton.innerText = "↓";
        dropButton.setAttribute(
          "aria-label",
          `${col + 1}번 열에 구슬 넣기`
        );

        dropButton.addEventListener("click", () => {
          dropMarble(col);
        });

        dropControlsEl.appendChild(dropButton);
      }

      // 게임판 생성
      for (let row = 0; row < ROWS; row++) {
        for (let col = 0; col < COLS; col++) {
          const cell = document.createElement("div");

          cell.className = "cell";
          cell.id = `cell-${row}-${col}`;

          gridEl.appendChild(cell);
        }
      }

      // 하단 구슬 빼기 버튼
      for (let col = 0; col < COLS; col++) {
        const popButton = document.createElement("button");

        popButton.className = "control-btn pop-btn";
        popButton.innerText = "▲";
        popButton.setAttribute(
          "aria-label",
          `${col + 1}번 열의 구슬 빼기`
        );

        popButton.addEventListener("click", () => {
          removeMarble(col);
        });

        popControlsEl.appendChild(popButton);
      }
    }

    // --------------------------------
    // 화면 렌더링
    // --------------------------------
    function render() {
      for (let row = 0; row < ROWS; row++) {
        for (let col = 0; col < COLS; col++) {
          const cell = document.getElementById(`cell-${row}-${col}`);

          cell.innerHTML = "";

          const value = board[row][col];

          if (value !== 0) {
            const marble = document.createElement("div");

            marble.className = `marble p${value}`;
            marble.setAttribute(
              "aria-label",
              `Player ${value}의 구슬`
            );

            cell.appendChild(marble);
          }
        }
      }

      score1El.innerText = scores[1];
      score2El.innerText = scores[2];

      updateControlsUI();
    }

    // --------------------------------
    // 버튼 및 안내 문구 갱신
    // --------------------------------
    function updateControlsUI() {
      const dropButtons =
        dropControlsEl.querySelectorAll("button");

      const popButtons =
        popControlsEl.querySelectorAll("button");

      /*
       * 보드가 한 번 가득 찬 뒤에는 phase가 REMOVE이므로
       * DROP 버튼은 영구적으로 비활성화됩니다.
       */
      dropButtons.forEach((button, col) => {
        const columnIsFull = board[0][col] !== 0;

        button.disabled =
          phase !== "DROP" || columnIsFull;
      });

      popButtons.forEach((button, col) => {
        const columnIsEmpty =
          board[ROWS - 1][col] === 0;

        button.disabled =
          phase !== "REMOVE" || columnIsEmpty;
      });

      if (phase === "DROP") {
        gameInfoEl.innerText =
          `Player ${currentPlayer}의 차례입니다. 구슬을 넣으세요.`;
      } else {
        gameInfoEl.innerText =
          `판이 가득 찼습니다. 점수 계산이 완료되었습니다. Player ${currentPlayer}의 차례입니다. 구슬을 빼세요.`;
      }
    }

    // --------------------------------
    // 구슬 넣기
    // --------------------------------
    function dropMarble(col) {
      /*
       * 보드가 한 번 가득 찬 이후에는
       * 이 함수가 실행되지 않습니다.
       */
      if (phase !== "DROP") {
        return;
      }

      let targetRow = -1;

      // 아래쪽부터 빈칸 찾기
      for (let row = ROWS - 1; row >= 0; row--) {
        if (board[row][col] === 0) {
          targetRow = row;
          break;
        }
      }

      // 해당 열이 가득 찬 경우
      if (targetRow === -1) {
        return;
      }

      board[targetRow][col] = currentPlayer;
      marbleCount++;

      /*
       * 게임 중에는 점수를 계산하지 않습니다.
       */

      /*
       * 보드가 처음으로 가득 찬 순간
       * 전체 점수를 한 번만 계산합니다.
       */
      if (
        marbleCount === MAX_MARBLES &&
        !scoreCalculated
      ) {
        calculateFinalScores();
        scoreCalculated = true;
        phase = "REMOVE";

        render();

        if (checkWinner()) {
          return;
        }

        return;
      }

      switchTurn();
      render();
    }

    // --------------------------------
    // 구슬 빼기
    // --------------------------------
    function removeMarble(col) {
      /*
       * REMOVE 단계는 보드가 한 번 가득 찬 뒤에만
       * 시작됩니다.
       */
      if (phase !== "REMOVE") {
        return;
      }

      // 해당 열에 구슬이 없는 경우
      if (board[ROWS - 1][col] === 0) {
        return;
      }

      /*
       * 아래 구슬을 제거하고,
       * 위의 구슬을 한 칸씩 아래로 이동합니다.
       */
      for (let row = ROWS - 1; row > 0; row--) {
        board[row][col] = board[row - 1][col];
      }

      board[0][col] = 0;
      marbleCount--;

      /*
       * 중요:
       * 구슬을 뺀 뒤에는 점수를 다시 계산하지 않습니다.
       * 점수는 보드가 처음 가득 찼을 때 확정되었습니다.
       */

      switchTurn();
      render();
    }

    // --------------------------------
    // 턴 교대
    // --------------------------------
    function switchTurn() {
      currentPlayer =
        currentPlayer === 1 ? 2 : 1;
    }

    // --------------------------------
    // 보드가 가득 찼을 때 최종 점수 계산
    // --------------------------------
    function calculateFinalScores() {
      scores = {
        1: 0,
        2: 0
      };

      for (let player = 1; player <= 2; player++) {
        scores[player] = calculatePlayerScore(player);
      }
    }

    // --------------------------------
    // 특정 플레이어의 점수 계산
    // --------------------------------
    function calculatePlayerScore(player) {
      const directions = [
        [0, 1],   // 가로
        [1, 0],   // 세로
        [1, 1],   // 대각선 ↘
        [1, -1]   // 대각선 ↙
      ];

      let totalScore = 0;

      for (let row = 0; row < ROWS; row++) {
        for (let col = 0; col < COLS; col++) {
          if (board[row][col] !== player) {
            continue;
          }

          for (const [dr, dc] of directions) {
            /*
             * 이전 칸에도 같은 플레이어의 구슬이 있으면
             * 현재 칸은 연속 줄의 시작점이 아닙니다.
             */
            const previousRow = row - dr;
            const previousCol = col - dc;

            const hasPreviousSameMarble =
              previousRow >= 0 &&
              previousRow < ROWS &&
              previousCol >= 0 &&
              previousCol < COLS &&
              board[previousRow][previousCol] === player;

            if (hasPreviousSameMarble) {
              continue;
            }

            // 현재 위치부터 같은 방향으로 연속 구슬 개수 계산
            let lineLength = 0;
            let nextRow = row;
            let nextCol = col;

            while (
              nextRow >= 0 &&
              nextRow < ROWS &&
              nextCol >= 0 &&
              nextCol < COLS &&
              board[nextRow][nextCol] === player
            ) {
              lineLength++;

              nextRow += dr;
              nextCol += dc;
            }

            /*
             * 최종 점수 규칙
             *
             * 정확히 4개 연속: 1점
             * 5개 이상 연속: 2점
             *
             * 이 계산은 보드가 가득 찬 순간에만 실행됩니다.
             */
            if (lineLength === 4) {
              totalScore += 1;
            } else if (lineLength >= 5) {
              totalScore += 2;
            }
          }
        }
      }

      return totalScore;
    }

    // --------------------------------
    // 승리 확인
    // --------------------------------
    function checkWinner() {
      if (scores[1] >= WIN_SCORE) {
        alert("Player 1 승리!");
        resetGame();
        return true;
      }

      if (scores[2] >= WIN_SCORE) {
        alert("Player 2 승리!");
        resetGame();
        return true;
      }

      return false;
    }

    // --------------------------------
    // 게임 초기화
    // --------------------------------
    function resetGame() {
      board = createEmptyBoard();

      currentPlayer = 1;

      scores = {
        1: 0,
        2: 0
      };

      phase = "DROP";
      marbleCount = 0;
      scoreCalculated = false;

      render();
    }

    // --------------------------------
    // 게임 시작
    // --------------------------------
    initBoard();
    render();
  </script>
</body>
